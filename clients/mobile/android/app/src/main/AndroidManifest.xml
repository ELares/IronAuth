<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="IronAuth AppAuth sample"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".SignInActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AppAuth's own RedirectUriReceiverActivity handles the custom-scheme callback; it is
          declared by the library's manifest and merged in, using the `appAuthRedirectScheme`
          placeholder from build.gradle.kts. Nothing needs declaring here for it, and
          declaring a second receiver for the same scheme is the usual way a sample breaks.
        -->
    </application>
</manifest>
